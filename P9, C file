#include <iostream>
using namespace std;

bool isPalindrome(int n){
    int num=n;
    int rev=0;
    while (n>0){
        int digit=n%10;
        rev= rev*10+ digit;
        n/10;
    }
    return num == rev;
}




int main(){
    int n;
    cin>>n;
   long long sum=0;
   
   for (int i=1; i<=n; i++){
       if (isPalindrome(i)){
          sum += i; 
       }
   }
   cout<< sum<<endl;
   
   return 0;
}
